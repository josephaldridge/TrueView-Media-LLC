# ---- Admin area ----
# Password you type at /admin/login. Use something long and unique.
ADMIN_PASSWORD=

# Signing key for the session cookie. Generate with:
#   openssl rand -base64 48
# Changing this immediately signs out any active session.
ADMIN_SESSION_SECRET=

# ---- Database ----
# Injected automatically when you attach a Postgres store in Vercel.
# Only needed locally if you want to run the admin on your machine.
POSTGRES_URL=
